# Supabase (Project Settings > API). The publishable key is safe for the browser;
# row level security is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Never prefix with NEXT_PUBLIC_ and never commit real values.
# DATABASE_URL=            # Postgres connection string, used by Drizzle migrations
# OPENCODE_API_KEY=        # assistant model provider key (Penny is off without it)
# OPENCODE_BASE_URL=       # defaults to https://opencode.ai/inference/go
# OPENCODE_MODEL=deepseek-v4.1-flash
# OPENCODE_VISION_MODEL=   # reads receipt photos and statements; defaults to OPENCODE_MODEL
# ASSISTANT_DAILY_CALL_CAP=3000        # model calls per day across everyone
# ASSISTANT_USER_DAILY_CALL_CAP=       # optional limit per person; off when empty
# VAPID_PUBLIC_KEY=        # web push
# VAPID_PRIVATE_KEY=
